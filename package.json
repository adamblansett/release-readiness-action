{
  "name": "@adamblansett/release-readiness-action",
  "version": "1.0.3",
  "description": "Configurable GitHub Action and developer CLI to evaluate software release-readiness before release or deployment.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "release-readiness": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build:types": "tsc --emitDeclarationOnly",
    "build:bundle": "node scripts/bundle.mjs",
    "build": "npm run clean && npm run build:types && npm run build:bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamblansett/release-readiness-action.git"
  },
  "keywords": [
    "github-action",
    "release-readiness",
    "devsecops",
    "ci-cd",
    "quality-gate",
    "pre-release",
    "secret-scanning",
    "compliance",
    "automation"
  ],
  "author": "Adam Blansett <https://adamblansett.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adamblansett/release-readiness-action/issues"
  },
  "homepage": "https://github.com/adamblansett/release-readiness-action#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.6",
    "picomatch": "^4.0.7",
    "tinypool": "^2.2.0",
    "minimatch": "^11.0.9",
    "glob": "^14.0.6",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
